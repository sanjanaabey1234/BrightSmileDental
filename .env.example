# Copy this file to .env and fill in the values.

PORT=3000

# Password for the staff dashboard at /admin. CHANGE THIS before going live.
ADMIN_PASSWORD=change-me-please

# Secret used to sign staff login tokens. Use a long random string.
ADMIN_SECRET=replace-with-a-long-random-string

# Optional. When set, the chatbot answers free-text questions with Claude and
# writes a clinician summary for each completed assessment. Without it, the bot
# uses the built-in dental knowledge base and a rule-based summary.
ANTHROPIC_API_KEY=

# Clinic details shown on the website and used by the chatbot.
CLINIC_NAME=BrightSmile Dental Care
CLINIC_PHONE=+94 11 234 5678
CLINIC_EMAIL=hello@brightsmile.example
CLINIC_ADDRESS=123 Galle Road, Colombo 03
CLINIC_HOURS=Mon-Sat 8:30am-6:00pm
EMERGENCY_NUMBER=1990
