# Copy this file to .env and fill in the values.

PORT=3000

# MongoDB Atlas connection string (Atlas > your cluster > Connect > Drivers).
# Replace <username> and <password> with a database user from Atlas > Database Access.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (created automatically on first use).
MONGODB_DB=brightsmile_dental

# Password for the staff dashboard at /admin. CHANGE THIS before going live.
ADMIN_PASSWORD=change-me-please

# Secret used to sign staff login tokens. Use a long random string.
ADMIN_SECRET=replace-with-a-long-random-string

# Optional. When set, the chatbot answers free-text questions with Claude and
# writes a clinician summary for each completed assessment. Without it, the bot
# uses the built-in dental knowledge base and a rule-based summary.
ANTHROPIC_API_KEY=

# Clinic details shown on the website and used by the chatbot.
# Leave CLINIC_PHONE and CLINIC_EMAIL empty to hide them.
CLINIC_NAME=SELF DOC
CLINIC_PHONE=
CLINIC_EMAIL=
CLINIC_ADDRESS=Faculty Of Dental Science, University Of Peradeniya
CLINIC_HOURS=Mon-Sat 8:00am-4:00pm
EMERGENCY_NUMBER=1990
