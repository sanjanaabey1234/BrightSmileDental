{
  "name": "dental-ai-bot",
  "version": "1.0.0",
  "description": "Dental clinic website with an OHAT-based oral health assessment chatbot, condition prediction, and a real-time staff dashboard.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test test/assessment.test.js test/i18n.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@vercel/functions": "^3.10.1",
    "express": "^4.22.3",
    "mongodb": "^7.7.0"
  }
}
